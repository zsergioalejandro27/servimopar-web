---
import Logo from './Logo.astro';
import Horario from './Horario.astro';
import { negocio, direccionCompleta } from '../config/negocio';
import { enlaceWhatsApp } from '../lib/whatsapp';
---
<footer class="pie">
  <div class="piso" aria-hidden="true"></div>
  <div class="pie__cuerpo">
    <div class="contenedor pie__rejilla">
      <div>
        <div class="pie__logo"><Logo variante="sobre-azul" /></div>
        <p>{negocio.descripcion}</p>
      </div>
      <div>
        <h2 class="pie__titulo">Visítanos</h2>
        <!-- NAP en texto plano: debe coincidir exactamente con el Perfil de Empresa en Google. -->
        <address>
          <strong>{negocio.nombre}</strong><br />
          {direccionCompleta}<br />
          Tel.: <a href={`tel:${negocio.telefono.e164}`}>{negocio.telefono.visible}</a><br />
          WhatsApp: <a href={enlaceWhatsApp()} target="_blank" rel="noopener">{negocio.whatsapp.visible}</a><br />
          <a href={`mailto:${negocio.correo}`}>{negocio.correo}</a>
        </address>
      </div>
      <div>
        <h2 class="pie__titulo">Horario</h2>
        <Horario />
      </div>
    </div>
    <div class="contenedor pie__legal">
      <p>
        Chevrolet, Dodge, Ram, Jeep, Mopar y las demás marcas mencionadas pertenecen a sus respectivos dueños.
        Sus nombres se usan solo para indicar con qué vehículos es compatible cada repuesto.
      </p>
      <p>© {new Date().getFullYear()} {negocio.nombreLegal}</p>
    </div>
  </div>
  <div class="baldosa pie__baldosa" aria-hidden="true"></div>
</footer>

<style>
  .pie__cuerpo { background: var(--azul-noche); color: #dfe6f3; padding-top: 40px; }
  .pie a { color: var(--blanco); }
  .pie__rejilla { display: grid; gap: 28px; }
  @media (min-width: 800px) { .pie__rejilla { grid-template-columns: 1.3fr 1fr 1fr; } }
  .pie__logo { width: 220px; margin-bottom: 12px; }
  .pie__titulo { color: var(--dorado); font-size: 1rem; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.06em; }
  address { font-style: normal; line-height: 1.8; }
  .pie__legal { margin-top: 28px; padding-block: 16px 24px; border-top: 1px solid rgb(255 255 255 / 0.15); font-size: 0.85rem; opacity: 0.85; }
  /* Base de baldosa azul, como la fachada; deja espacio al botón flotante de WhatsApp. */
  .pie__baldosa { height: 92px; }
</style>
