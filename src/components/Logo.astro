---
// Logo en línea (inline): usa la Montserrat que ya carga la página y no cuesta
// una petición extra. Mismo diseño que scripts/generar-imagenes-marca.mjs:
// letras doradas con sombra azul desplazada, como el letrero del almacén.
interface Props {
  variante?: 'claro' | 'sobre-azul';
  subtitulo?: boolean;
  class?: string;
}
const { variante = 'claro', subtitulo = true, class: clase } = Astro.props;
const sombra = variante === 'sobre-azul' ? '#0F2A5C' : '#1F4E9E';
const sub = variante === 'sobre-azul' ? '#FFFFFF' : '#1F4E9E';
const fuente = "Montserrat, 'Arial Black', Arial, sans-serif";
---
<svg class={clase} viewBox={subtitulo ? '0 0 560 130' : '0 0 560 84'} role="img" aria-label="Servimopar" xmlns="http://www.w3.org/2000/svg">
  <text x="9" y="72" textLength="540" lengthAdjust="spacingAndGlyphs" font-family={fuente} font-weight="800" font-size="70" fill={sombra}>SERVIMOPAR</text>
  <text x="12" y="68" textLength="540" lengthAdjust="spacingAndGlyphs" font-family={fuente} font-weight="800" font-size="70" fill="#E0A92E">SERVIMOPAR</text>
  {subtitulo && (
    <text x="14" y="118" textLength="536" lengthAdjust="spacingAndGlyphs" font-family="Inter, Arial, sans-serif" font-weight="700" font-size="17" fill={sub}>REPUESTOS · IMPORTADORES Y DISTRIBUIDORES</text>
  )}
</svg>
