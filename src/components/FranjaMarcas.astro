---
// Inspirada en el letrero pintado del mezzanine y las ventanas del almacén
// ("CHEVROLET · DODGE · KODIAK · N.P.R. · LUV"). Solo nombres en texto:
// nunca logos de las marcas.
const marcas = [
  { nombre: 'Chevrolet', estilo: 'azul' },
  { nombre: 'Dodge', estilo: 'terracota' },
  { nombre: 'Ram', estilo: 'oscuro' },
  { nombre: 'Jeep', estilo: 'azul' },
  { nombre: 'Mopar', estilo: 'terracota' },
  { nombre: 'Kodiak', estilo: 'oscuro' },
  { nombre: 'NPR', estilo: 'azul' },
  { nombre: 'NKR', estilo: 'oscuro' },
  { nombre: 'LUV', estilo: 'caja-roja' },
];
---
<div class="franja">
  <ul aria-label="Marcas de vehículos que atendemos">
    {marcas.map((m) => <li class={`m-${m.estilo}`}>{m.nombre}</li>)}
  </ul>
</div>

<style>
  .franja {
    background: var(--blanco);
    border-block: 3px solid var(--azul);
    box-shadow: inset 0 -6px 0 var(--fondo-suave);
  }
  ul {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: 6px 22px; list-style: none; margin: 0 auto; padding: 16px var(--gutter);
    max-width: var(--ancho-max);
  }
  li {
    font-family: var(--fuente-titulos); font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.08em; font-size: clamp(1rem, 3.6vw, 1.35rem);
  }
  .m-azul { color: var(--azul); }
  .m-terracota { color: #a8502f; /* terracota un poco más oscura para buen contraste sobre blanco */ }
  .m-oscuro { color: var(--texto); }
  .m-caja-roja { background: var(--rojo); color: var(--blanco); padding: 0 10px; border-radius: 3px; }
</style>
