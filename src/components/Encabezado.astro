---
// El encabezado imita el letrero del almacén: fondo blanco, letras doradas con
// sombra azul y, debajo, las barras azules y blancas del portón.
import Logo from './Logo.astro';
import { negocio } from '../config/negocio';

const ruta = Astro.url.pathname;
// TODO (etapas 3 y 4): agregar Repuestos, Dodge Journey y Nosotros cuando existan.
const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/contacto/', texto: 'Contacto' },
];
---
<header class="encabezado">
  <div class="contenedor encabezado__fila">
    <a href="/" class="encabezado__logo" aria-label="Servimopar, ir al inicio">
      <Logo />
    </a>
    <nav aria-label="Principal">
      <ul>
        {enlaces.map((e) => (
          <li>
            <a href={e.href} aria-current={ruta === e.href ? 'page' : undefined}>{e.texto}</a>
          </li>
        ))}
        <li class="encabezado__tel">
          <a href={`tel:${negocio.telefono.e164}`}>{negocio.telefono.visible}</a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="rayas-porton" aria-hidden="true"></div>
</header>

<style>
  .encabezado { background: var(--blanco); border-top: 4px solid var(--azul); }
  .encabezado__fila {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 68px;
  }
  .encabezado__logo { display: block; width: 168px; flex: none; }
  .encabezado__logo :global(svg) { display: block; width: 100%; height: auto; }
  ul { display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block; padding: 10px 8px;
    color: var(--azul-noche); text-decoration: none; font-weight: 700; font-size: 0.95rem;
    border-radius: 6px;
  }
  nav a:hover { background: var(--fondo-suave); }
  nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--dorado); }
  .encabezado__tel { display: none; }
  .encabezado__tel a { color: var(--blanco); background: var(--azul); padding-inline: 14px; margin-left: 8px; }
  .encabezado__tel a:hover { background: var(--azul-noche); }
  @media (min-width: 760px) {
    .encabezado__logo { width: 230px; }
    .encabezado__tel { display: block; }
  }
</style>
