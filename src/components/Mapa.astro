---
import { mapaEmbed, mapaComoLlegar } from '../config/negocio';
---
<div class="mapa">
  <!-- loading="lazy": el mapa de Google pesa mucho; solo se descarga al acercarse a él. -->
  <iframe
    src={mapaEmbed}
    title="Mapa: ubicación de Servimopar en el Centro de Bucaramanga"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    width="600" height="400"
  ></iframe>
  <a class="boton boton--azul" href={mapaComoLlegar} target="_blank" rel="noopener">Cómo llegar con Google Maps</a>
</div>

<style>
  .mapa { display: grid; gap: 12px; }
  iframe { width: 100%; height: 320px; border: 0; border-radius: var(--radio); background: var(--fondo-suave); }
  @media (min-width: 800px) { iframe { height: 400px; } }
</style>
