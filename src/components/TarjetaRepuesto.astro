---
// Tarjeta de repuesto destacado: sin precio ni disponibilidad (se cotizan por
// WhatsApp). El nombre lleva a la página del repuesto; el botón abre el chat.
import IconoWhatsApp from './IconoWhatsApp.astro';
import { type Repuesto, tituloRepuesto, fotoUrl, mensajeCotizacion } from '../lib/inventario';
import { enlaceWhatsApp } from '../lib/whatsapp';

interface Props {
  repuesto: Repuesto;
}
const { repuesto: r } = Astro.props;
const titulo = tituloRepuesto(r);
---
<article class="tarjeta">
  <img
    src={fotoUrl(r)}
    alt={r.foto ? titulo : ''}
    width="400" height="300" loading="lazy" decoding="async"
  />
  <div class="tarjeta__cuerpo">
    <h3><a href={`/repuestos/${r.slug}/`}>{titulo}</a></h3>
    {r.numeroParte && <p class="tarjeta__ref">Ref. <span class="mono">{r.numeroParte}</span></p>}
    <a class="boton boton--whatsapp tarjeta__cta" href={enlaceWhatsApp(mensajeCotizacion(r))} target="_blank" rel="noopener">
      <IconoWhatsApp /> Cotizar precio y disponibilidad
    </a>
  </div>
</article>

<style>
  .tarjeta {
    display: grid; grid-template-columns: 104px 1fr;
    background: var(--blanco); border: 1px solid var(--borde); border-radius: var(--radio);
    overflow: hidden; box-shadow: var(--sombra);
  }
  @media (min-width: 560px) { .tarjeta { display: flex; flex-direction: column; } }
  img { width: 100%; height: 100%; object-fit: cover; background: var(--fondo-suave); }
  @media (min-width: 560px) { img { height: auto; aspect-ratio: 4 / 3; } }
  .tarjeta__cuerpo { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px; flex: 1; }
  h3 { font-size: 1rem; margin: 0; }
  h3 a { color: var(--azul-noche); text-decoration: none; }
  h3 a:hover { color: var(--azul); text-decoration: underline; }
  .tarjeta__ref { font-size: 0.85rem; color: var(--texto-suave); margin: 0; }
  .tarjeta__cta { margin-top: auto; min-height: 44px; padding: 0.55em 0.8em; font-size: 0.9rem; width: 100%; }
</style>
