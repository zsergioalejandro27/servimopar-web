---
import Base from '../layouts/Base.astro';
import IconoWhatsApp from '../components/IconoWhatsApp.astro';
import Mapa from '../components/Mapa.astro';
import Foto from '../components/Foto.astro';
import Horario from '../components/Horario.astro';
import { jsonLdNegocio } from '../lib/seo';
import { enlaceWhatsApp } from '../lib/whatsapp';
import { negocio, direccionCompleta, fotosLocal } from '../config/negocio';
---
<Base
  titulo="Contacto, horario y cómo llegar | Servimopar Bucaramanga"
  descripcion={`Servimopar: ${negocio.direccion.calle}, Centro de Bucaramanga. Lunes a viernes 8 a. m. a 5 p. m. y sábados 8 a. m. a 12 m. Tel. ${negocio.telefono.visible} y WhatsApp.`}
  jsonLd={[jsonLdNegocio(Astro.site)]}
>
  <div class="contenedor seccion">
    <h1 class="titulo-seccion">Contacto y cómo llegar</h1>
    <p>La forma más rápida es WhatsApp: envíanos el modelo, el año y el repuesto que necesitas.</p>

    <div class="contacto">
      <div class="contacto__datos">
        <a class="boton boton--whatsapp" href={enlaceWhatsApp()} target="_blank" rel="noopener">
          <IconoWhatsApp /> WhatsApp {negocio.whatsapp.visible}
        </a>

        <h2>Dirección</h2>
        <address>
          <strong>{negocio.nombre}</strong><br />
          {direccionCompleta}, Colombia
        </address>

        <h2>Horario</h2>
        <Horario />

        <h2>Teléfono y correo</h2>
        <p>
          Teléfono: <a href={`tel:${negocio.telefono.e164}`}>{negocio.telefono.visible}</a><br />
          Correo: <a href={`mailto:${negocio.correo}`}>{negocio.correo}</a>
        </p>
      </div>

      <div class="contacto__mapa">
        <h2>Así se ve el almacén desde la calle</h2>
        <figure>
          <Foto src={fotosLocal.fachadaCerrada.src} alt={fotosLocal.fachadaCerrada.alt} sizes="(min-width: 800px) 600px, 100vw" />
          <figcaption>Letrero blanco con letras doradas y portón azul y blanco, número 24-36.</figcaption>
        </figure>
        <h2>Mapa</h2>
        <Mapa />
      </div>
    </div>
  </div>
</Base>

<style>
  .contacto { display: grid; gap: 32px; margin-top: 24px; }
  @media (min-width: 800px) { .contacto { grid-template-columns: 1fr 1.5fr; align-items: start; } }
  .contacto h2 { font-size: 1.1rem; margin-top: 24px; }
  .contacto__mapa h2:first-child { margin-top: 0; }
  address { font-style: normal; line-height: 1.8; }
  figure { margin: 0; }
  figure :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 40%; border-radius: var(--radio); }
  figcaption { font-size: 0.9rem; color: var(--texto-suave); margin-top: 6px; }
</style>
