---
// Página pensada para posicionar "repuestos Dodge Journey" (+ Bucaramanga, + pieza).
// Google premia el contenido que resuelve la búsqueda: por eso tiene texto útil,
// accesos por pieza, qué datos enviar y preguntas frecuentes, no solo un listado.
import Base from '../layouts/Base.astro';
import IconoWhatsApp from '../components/IconoWhatsApp.astro';
import PiezasJourney from '../components/PiezasJourney.astro';
import TarjetaRepuesto from '../components/TarjetaRepuesto.astro';
import Horario from '../components/Horario.astro';
import { repuestosDe } from '../lib/inventario';
import { absoluta } from '../lib/seo';
import { enlaceWhatsApp } from '../lib/whatsapp';
import { negocio, direccionCompleta, mapaComoLlegar, horarioEnUnaLinea } from '../config/negocio';

const destacados = repuestosDe('Journey');
const mensajeGeneral = 'Hola, busco un repuesto para mi Dodge Journey. Año: ';

const migas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: absoluta('/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Repuestos Dodge Journey', item: absoluta('/dodge-journey/', Astro.site) },
  ],
};
---
<Base
  titulo="Repuestos Dodge Journey en Bucaramanga | Servimopar"
  descripcion="Repuestos para Dodge Journey en Bucaramanga: soporte de motor, frenos, bomba de agua, rótulas y más. Cotiza precio y disponibilidad por WhatsApp en Servimopar."
  jsonLd={[migas]}
  mensajeWhatsApp={mensajeGeneral}
>
  <section class="cabecera">
    <div class="contenedor">
      <nav class="migas" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>{' '}<span aria-hidden="true">›</span>{' '}<span>Dodge Journey</span>
      </nav>
      <h1>Repuestos para Dodge Journey en Bucaramanga</h1>
      <p class="cabecera__sub">
        Dinos el año de tu Journey y la pieza que necesitas: te confirmamos precio y disponibilidad por WhatsApp.
      </p>
      <a class="boton boton--whatsapp" href={enlaceWhatsApp(mensajeGeneral)} target="_blank" rel="noopener">
        <IconoWhatsApp /> Cotizar precio y disponibilidad
      </a>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <h2 class="titulo-seccion">¿Qué pieza necesitas para tu Journey?</h2>
      <p class="intro">Toca la pieza y se abre WhatsApp con el mensaje listo; solo agrega el año de tu Journey.</p>
      <PiezasJourney />
    </div>
  </section>

  {destacados.length > 0 && (
    <section class="seccion seccion--suave">
      <div class="contenedor">
        <h2 class="titulo-seccion">Repuestos destacados para Dodge Journey</h2>
        <div class="rejilla">
          {destacados.map((r) => <TarjetaRepuesto repuesto={r} />)}
        </div>
      </div>
    </section>
  )}

  <section class="seccion">
    <div class="contenedor dos-columnas">
      <div>
        <h2 class="titulo-seccion">Para cotizar más rápido, envíanos</h2>
        <ol class="pasos">
          <li><strong>El año</strong> de tu Dodge Journey.</li>
          <li><strong>El motor</strong> o la versión, si los sabes.</li>
          <li><strong>El número de parte</strong> de la pieza vieja o <strong>una foto</strong> de ella.</li>
          <li>Si tienes dudas, <strong>el VIN</strong> que aparece en la tarjeta de propiedad.</li>
        </ol>
        <p>Con esos datos te confirmamos que el repuesto sea el correcto para tu vehículo antes de que vengas.</p>
      </div>
      <div class="visita">
        <h2 class="titulo-seccion">Visítanos</h2>
        <address>
          <strong>{negocio.nombre}</strong><br />
          {direccionCompleta}<br />
          Tel.: <a href={`tel:${negocio.telefono.e164}`}>{negocio.telefono.visible}</a><br />
          WhatsApp: <a href={enlaceWhatsApp(mensajeGeneral)} target="_blank" rel="noopener">{negocio.whatsapp.visible}</a>
        </address>
        <Horario />
        <p class="visita__mapa"><a href={mapaComoLlegar} target="_blank" rel="noopener">Cómo llegar con Google Maps</a></p>
      </div>
    </div>
  </section>

  <section class="seccion seccion--suave">
    <div class="contenedor">
      <h2 class="titulo-seccion">Preguntas frecuentes</h2>
      <div class="faq">
        <details>
          <summary>¿Cómo cotizo un repuesto para mi Dodge Journey?</summary>
          <p>
            Escríbenos por WhatsApp al {negocio.whatsapp.visible} con el año de tu Journey y la pieza que buscas.
            Te respondemos con el precio y la disponibilidad.
          </p>
        </details>
        <details>
          <summary>¿Cómo sé si el repuesto le sirve a mi Journey?</summary>
          <p>
            Envíanos el año, el motor y, si puedes, el número de parte o una foto de la pieza vieja.
            Con eso verificamos la referencia antes de que vengas al almacén.
          </p>
        </details>
        <details>
          <summary>¿Dónde queda Servimopar?</summary>
          <p>
            En la {direccionCompleta}. Busca el letrero blanco con letras doradas y el portón azul y blanco.
          </p>
        </details>
        <details>
          <summary>¿Qué horario tienen?</summary>
          <p>{horarioEnUnaLinea}. {negocio.cerrado}: cerrado.</p>
        </details>
        <details>
          <summary>¿Tienen repuestos para otros vehículos?</summary>
          <p>
            Sí: también atendemos {negocio.marcas.filter((m) => m !== 'Dodge').join(', ')} y otros modelos Dodge.
            <a href="/">Ver la página de inicio</a>.
          </p>
        </details>
      </div>
    </div>
  </section>
</Base>

<style>
  .cabecera { background: linear-gradient(160deg, var(--azul) 0%, var(--azul-noche) 100%); color: var(--blanco); padding-block: 8px 44px; }
  .cabecera h1 { color: var(--blanco); max-width: 22ch; }
  .cabecera__sub { font-size: 1.1rem; max-width: 46ch; }
  .migas { font-size: 0.9rem; padding-block: 14px 18px; color: #c9d4ea; }
  .migas a { color: #c9d4ea; }
  .intro { max-width: 65ch; margin-bottom: 18px; }
  .dos-columnas { display: grid; gap: 32px; }
  @media (min-width: 860px) { .dos-columnas { grid-template-columns: 1.2fr 1fr; } }
  .pasos { padding-left: 1.3em; }
  .pasos li { margin-bottom: 6px; }
  address { font-style: normal; line-height: 1.8; margin-bottom: 12px; }
  .visita__mapa { margin-top: 14px; }
  .faq { display: grid; gap: 10px; max-width: 800px; }
  details { background: var(--blanco); border: 1px solid var(--borde); border-radius: var(--radio); padding: 4px 16px; }
  summary { cursor: pointer; padding: 12px 0; font-weight: 700; color: var(--azul-noche); }
  details p { margin-bottom: 14px; }
</style>
