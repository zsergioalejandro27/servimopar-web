---
// Una página estática por cada fila del CSV. getStaticPaths se ejecuta en el
// build: Astro genera /repuestos/<slug>/index.html para cada repuesto.
import Base from '../../layouts/Base.astro';
import TarjetaRepuesto from '../../components/TarjetaRepuesto.astro';
import IconoWhatsApp from '../../components/IconoWhatsApp.astro';
import {
  inventario, type Repuesto, tituloRepuesto, rangoAnios, vehiculo, precioLegible,
  disponibilidad, fotoUrl, mensajeCotizacion, relacionados,
} from '../../lib/inventario';
import { jsonLdProducto, descripcionRepuesto, absoluta } from '../../lib/seo';
import { enlaceWhatsApp } from '../../lib/whatsapp';
import { negocio } from '../../config/negocio';

export function getStaticPaths() {
  return inventario.map((repuesto) => ({ params: { slug: repuesto.slug }, props: { repuesto } }));
}

interface Props {
  repuesto: Repuesto;
}
const { repuesto: r } = Astro.props;

const titulo = tituloRepuesto(r);
const precio = precioLegible(r);
const disp = disponibilidad(r);
const anios = rangoAnios(r);
const auto = vehiculo(r);
const mensaje = mensajeCotizacion(r);
const urlPagina = absoluta(Astro.url.pathname, Astro.site);
const otros = relacionados(r);

const textoDisp = {
  disponible: 'Disponible en el almacén',
  agotado: 'Agotado por ahora: pregúntanos por alternativas',
  consultar: 'Consulta disponibilidad por WhatsApp',
}[disp];

// Las fotos .svg (placeholder) no sirven para Open Graph; en ese caso se usa la imagen de marca.
const imagenOg = r.foto && !r.foto.endsWith('.svg') ? fotoUrl(r) : undefined;
---
<Base
  titulo={`${titulo} | Servimopar Bucaramanga`}
  descripcion={descripcionRepuesto(r, precio)}
  imagenOg={imagenOg}
  tipoOg="product"
  noindex={r.esEjemplo}
  jsonLd={[jsonLdProducto(r, Astro.site, urlPagina)]}
  mensajeWhatsApp={mensaje}
>
  <div class="contenedor">
    <nav class="migas" aria-label="Ruta de navegación">
      <a href="/">Inicio</a> <span aria-hidden="true">›</span>
      <span>{r.nombre}</span>
    </nav>

    {r.esEjemplo && (
      <p class="aviso">Página de <strong>EJEMPLO</strong> con datos falsos para probar la plantilla. No se publica.</p>
    )}

    <div class="ficha">
      <div class="ficha__foto">
        <!-- Imagen principal: carga inmediata (es el elemento más grande de la pantalla, LCP). -->
        <img
          src={fotoUrl(r)}
          alt={r.foto ? `${titulo}${r.marcaRepuesto ? `, marca ${r.marcaRepuesto}` : ''}` : `Foto pendiente de ${titulo}`}
          width="800" height="600" fetchpriority="high" decoding="async"
        />
      </div>

      <div class="ficha__datos">
        <h1>{titulo}</h1>

        <p class="ficha__precio">
          {precio ? <><strong>{precio}</strong> <small>COP</small></> : <strong>Precio: cotizar</strong>}
        </p>
        <p><span class={`etiqueta etiqueta--${disp}`}>{textoDisp}</span></p>

        <a class="boton boton--whatsapp ficha__cta" href={enlaceWhatsApp(mensaje)} target="_blank" rel="noopener">
          <IconoWhatsApp /> Cotizar por WhatsApp
        </a>
        <a class="boton boton--borde ficha__cta" href={`tel:${negocio.telefono.e164}`}>
          Llamar al {negocio.telefono.visible}
        </a>

        <dl class="ficha__tabla">
          <div><dt>Repuesto</dt><dd>{r.nombre}</dd></div>
          {auto && <div><dt>Compatible con</dt><dd>{auto}{anios && ` (${anios})`}</dd></div>}
          {r.marcaRepuesto && <div><dt>Marca del repuesto</dt><dd>{r.marcaRepuesto}</dd></div>}
          {r.numeroParte && <div><dt>Número de parte</dt><dd class="mono">{r.numeroParte}</dd></div>}
          {r.categoria && <div><dt>Categoría</dt><dd>{r.categoria}</dd></div>}
        </dl>
        <p class="ficha__nota">
          Dinos el modelo, el año y, si lo tienes, el número de parte: te confirmamos que sea el correcto para tu vehículo.
        </p>
      </div>
    </div>

    {r.descripcion && (
      <section class="seccion">
        <h2>Descripción</h2>
        <p>{r.descripcion}</p>
      </section>
    )}

    {otros.length > 0 && (
      <section class="seccion">
        <h2>Otros repuestos para {auto || 'este vehículo'}</h2>
        <div class="rejilla">
          {otros.map((o) => <TarjetaRepuesto repuesto={o} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .migas { font-size: 0.9rem; padding-block: 14px; color: var(--texto-suave); }
  .migas a { color: var(--texto-suave); }
  .ficha { display: grid; gap: 24px; padding-bottom: 16px; }
  @media (min-width: 820px) { .ficha { grid-template-columns: 1fr 1fr; align-items: start; } }
  .ficha__foto img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radio); background: var(--fondo-suave); }
  .ficha__precio { font-size: 1.6rem; font-family: var(--fuente-titulos); color: var(--azul-noche); margin-bottom: 8px; }
  .ficha__precio small { font-size: 0.9rem; color: var(--texto-suave); }
  .ficha__cta { width: 100%; margin-top: 10px; }
  @media (min-width: 820px) { .ficha__cta { width: auto; margin-right: 8px; } }
  .ficha__tabla { margin: 24px 0 12px; border-top: 1px solid var(--borde); }
  .ficha__tabla div { display: grid; grid-template-columns: 9.5em 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--borde); }
  dt { font-weight: 600; color: var(--texto-suave); }
  dd { margin: 0; }
  .ficha__nota { font-size: 0.95rem; color: var(--texto-suave); }
</style>
